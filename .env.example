# URL publique du site, utilisee pour les URLs absolues (sitemap, robots,
# balises Open Graph et canoniques).
#
# Sur Vercel, laisser vide : la plateforme injecte automatiquement
# VERCEL_PROJECT_PRODUCTION_URL et le site s'y adapte.
#
# A renseigner uniquement en cas de domaine personnalise, par exemple :
# NEXT_PUBLIC_SITE_URL=https://geovic.dev
NEXT_PUBLIC_SITE_URL=https://geovickpossilande.com
